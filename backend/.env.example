# Copy to .env and fill in. .env is git-ignored.
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
MONGODB_DB=gurtu

# Firebase Admin, to send push notifications. Either a path to the service
# account JSON (Firebase console > Project settings > Service accounts >
# Generate new private key) or the JSON itself in one line.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=gurtu-f6687

# Reminders are stored with their own time zone; this is the default.
DEFAULT_TIMEZONE=Asia/Kolkata
