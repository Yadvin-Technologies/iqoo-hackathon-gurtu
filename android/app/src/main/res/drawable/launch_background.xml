<?xml version="1.0" encoding="utf-8"?>
<!-- Shown for the moment before Flutter draws: Gurtu's background with the
     app icon, so it hands over smoothly to the animated splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/gurtu_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
